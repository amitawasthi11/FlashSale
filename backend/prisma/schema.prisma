
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings  Booking[]
}


model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  venue       String
  startsAt    DateTime
  totalSeats  Int
  availableSeats Int
  priceInPaise Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings    Booking[]
   @@index([startsAt])
}

model Booking {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  quantity  Int @default(1)
  totalAmountPaise Int @default(0)
  status    BookingStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  @@index([userId])
  @@index([eventId, status])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}
